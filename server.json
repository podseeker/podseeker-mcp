{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "co.podseeker/podseeker",
  "title": "Podseeker",
  "description": "Search active podcasts, get host and producer contacts, and get podcast recommendations for clients.",
  "version": "1.0.0",
  "websiteUrl": "https://www.podseeker.co/podcast-api",
  "icons": [
    { "src": "https://app.podseeker.co/podseeker-icon-512.png", "mimeType": "image/png", "sizes": ["512x512"] },
    { "src": "https://app.podseeker.co/podseeker-icon.svg", "mimeType": "image/svg+xml", "sizes": ["any"] }
  ],
  "remotes": [
    { "type": "streamable-http", "url": "https://app.podseeker.co/mcp" }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "authentication": { "required": true, "type": "oauth2" },
      "documentationUrl": "https://app.podseeker.co/api/docs#ai-assistants",
      "privacyPolicyUrl": "https://www.podseeker.co/privacy",
      "support": "support@podseeker.co"
    }
  }
